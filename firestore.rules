rules_version = '2';

// Şipşak için Firestore güvenlik kuralları.
// Firebase konsolu > Firestore Database > Rules sekmesine yapıştır, Publish'e bas.
service cloud.firestore {
  match /databases/{database}/documents {

    match /users/{uid} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == uid;
    }

    match /groups/{gid} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && request.resource.data.ownerId == request.auth.uid;
      // Üyeler yalnızca kendi kayıtlarını ekleyip çıkarabilir.
      allow update: if request.auth != null
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['members'])
        && request.resource.data.members.diff(resource.data.members).affectedKeys().hasOnly([request.auth.uid]);

      match /days/{day}/posts/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }

      match /days/{day}/votes/{uid} {
        allow read: if request.auth != null;
        allow write: if request.auth != null && request.auth.uid == uid
          && request.resource.data.target != uid
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(gid)).data.members;
      }
    }

    match /reports/{id} {
      allow create: if request.auth != null;
    }
  }
}
